# Copy to .env and fill in real values. .env is gitignored - never commit real secrets.
# For local dev, SUPABASE_URL/ANON_KEY/SERVICE_ROLE_KEY come from `supabase start`'s own
# output (it prints all three) - do not use production values locally.

# --- Supabase (local: from `supabase start` output; prod: your hosted project settings) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-or-prod-anon-key
# service_role bypasses RLS - server-side CLI use only (migrate/generate/ingest), never in a browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-prod-service-role-key

# --- GCS (local: fake-gcs-server from docker-compose; prod: real bucket) ---
GCP_PROJECT_ID=replace-with-gcp-project-id
GCS_BUCKET_NAME=softball-scouting-media
# Local dev only - points the GCS client at the fake-gcs-server container instead of real GCS.
GCS_EMULATOR_HOST=http://localhost:4443

# --- Gemini (Developer API / Google AI Studio key - NOT a Vertex AI service account) ---
# Get a fresh key from https://aistudio.google.com/apikey - never commit this value.
GEMINI_API_KEY=replace-with-your-own-gemini-api-key
# Explicit model selection; the worker has no fallback. Google currently documents this stable ID.
GEMINI_MODEL=gemini-2.5-flash
# Required for any child name/image/video processing. Set only after the API
# project has active Cloud Billing and the current paid-service terms are reviewed.
GEMINI_PAID_SERVICE_CONFIRMED=false

# --- AI analyzer backend for processUploadQueue.ts's automatic post-upload diagnosis ---
# Leave unset (or "gemini") for production - the real path, using GEMINI_API_KEY above.
# Set to "claude-cli" for local testing only: shells out to the `claude` CLI
# (@anthropic-ai/claude-code, installed globally) instead, reusing whatever Claude
# subscription is already logged in on this machine rather than a separate metered key -
# see src/services/ai/claudeCliAnalyzer.ts. Never set this in a real deployment; a
# developer's local subscription login isn't a real server-side credential.
AI_ANALYZER=gemini
# Required only for the local claude-cli backend; also recorded in analysis provenance.
CLAUDE_CLI_MODEL=sonnet
# Required before Claude CLI receives child imagery or video-derived evidence.
# Set only after reviewing the logged-in account's data terms for this footage.
# Gemini/AGY confirmations do not cover this separate account/provider path.
CLAUDE_CLI_DATA_CONFIRMED=false
# Or "agy-cli" for local testing only: shells out to the Antigravity CLI (`agy`) on this
# machine's own login - see src/services/ai/agyCliAnalyzer.ts. Model from `agy models`.
AGY_ANALYZER_MODEL=gemini-3.1-pro-high
# agy sends player swing stills to Google under the logged-in Antigravity account's terms, which
# GEMINI_PAID_SERVICE_CONFIRMED does not cover. The agy backend refuses to run until this is true.
AGY_ANALYZER_DATA_CONFIRMED=false

# --- Notification delivery worker (npm run dispatch-notifications) ---
# Push is enabled when a Firebase project and Application Default Credentials are available.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
# Email fallback uses Resend. APP_BASE_URL must end at the deployed coach-app directory.
RESEND_API_KEY=replace-with-resend-api-key
NOTIFICATION_FROM_EMAIL=HitterLoop <reports@example.com>
APP_BASE_URL=https://example.com/coach/
