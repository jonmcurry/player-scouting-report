# Real swing footage and extracted frames never get published or committed —
# only the reports (text/scores) go to GitHub Pages, never the media itself.
videos/*
!videos/.gitkeep
frames/*
!frames/.gitkeep
validation/*manifest*.json
!validation/validation-manifest.example.json

# Pose-estimation output (annotated videos/frames of real players) and the
# downloaded MediaPipe model file - same policy as videos/frames above, plus
# the model is a large binary better fetched on demand than committed.
scripts/pose_out/
scripts/models/

# pose3d pipeline's own YOLO weights (yolo11m-pose.pt, yolov8m.pt) - same
# large-binary-fetched-on-demand policy as scripts/models/ above (see
# scripts/pose3d/README.md's own setup instructions) - scripts/models/ above
# does NOT cover this separate path, confirmed missing here rather than
# assumed covered.
scripts/pose3d/models/

# Isolated venv + cloned model repos + checkpoints for the pose3d pipeline -
# multi-GB, machine-specific, reproducible from scripts/pose3d/README.md.
# (frames/* below already covers all pipeline output under frames/.)
.venv_pose3d/

# Python bytecode cache - regenerated locally, never meaningful to commit.
__pycache__/
*.pyc

# Node/TypeScript CLI layer (src/, package.json) - real secrets live only in .env,
# never committed; .env.example (placeholders only) is the tracked template.
node_modules/
dist/
.env

# Supabase CLI local dev state - regenerated by `supabase start`, machine-specific.
supabase/.branches/
supabase/.temp/

# OS/editor cruft
.DS_Store
Thumbs.db

# Capacitor mobile shell (mobile/) - own dependency tree, kept separate from
# the root Node CLI's node_modules/. Platform folders (mobile/android/,
# mobile/ios/) ARE committed per Capacitor convention - build artifacts
# inside them are covered by the nested .gitignore files `cap add` generates.
mobile/node_modules/

# Android/iOS release-signing material - never commit these.
mobile/android/*.keystore
mobile/android/*.jks
mobile/android/keystore.properties

# Per-dev-machine LAN override for the coach app's native-shell config (see
# coach/config.js) - same .env/.env.example pattern as above: this file is
# specific to one dev's home network, coach/config.local.example.js is the
# tracked template. webDir points straight at coach/ (see
# mobile/capacitor.config.json), so this genuinely ships into a native build
# if committed - never commit it.
coach/config.local.js

# Per-dev-machine local demo-mode override (see coach/demoConfig.js) - same
# pattern as coach/config.local.js above: coach/demo.local.example.js is the
# tracked template. Never commit real demo project keys here even though
# they're anon keys (RLS-protected, not secret) - same reasoning as
# config.local.js not being committed.
coach/demo.local.js

# Real-data demo promotion (docs/research/demo-real-data-promotion.md):
# exported fixtures, transcoded real media, and real curation manifests
# (consent records, source slugs/ids) carry real athlete data - this is a
# public repo, never commit them. The example manifest is fictional.
demo-export/
demo-curation*.json
!docs/research/demo-curation.example.json

# Local OCR tool venv for scripts/privacy/ocr_check.py (RapidOCR) - machine-specific.
.venv_ocr/

# Local multi-agent QA scratch files
.agent-tmp/
