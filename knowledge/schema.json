{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BarrelIQ manually reviewed knowledge claims",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "concept", "claim_text", "observable_evidence", "sport_scope", "age_guardrail", "applies_when", "does_not_apply_when", "coaching_cue", "classification", "status", "human_verified", "source_url", "source_timestamp", "evidence_type", "numeric_normative", "numeric_evidence_ref"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "concept": { "enum": ["stance_setup", "load", "stride_plant", "hip_shoulder_sequencing", "hand_path", "barrel_path", "contact", "extension", "head_visual_stability", "finish_balance", "swing_decision", "timing", "front_side_stability", "posture", "barrel_depth", "pitch_location_adjustment", "game_approach"] },
      "claim_text": { "type": "string", "minLength": 1 },
      "observable_evidence": { "type": "string" },
      "sport_scope": { "enum": ["baseball", "softball", "both"] },
      "age_guardrail": { "enum": ["youth_appropriate", "teen_appropriate", "advanced_only", "requires_physical_screening"] },
      "applies_when": { "type": "string" },
      "does_not_apply_when": { "type": "string" },
      "coaching_cue": { "type": ["string", "null"] },
      "classification": { "enum": ["candidate_unclassified", "shared_principle", "optional_interpretation", "disputed", "source_specific", "unsupported", "unsupported_numeric_claim", "rejected"] },
      "status": { "enum": ["candidate", "approved", "rejected", "superseded"] },
      "human_verified": { "type": "boolean" },
      "source_url": { "type": ["string", "null"] },
      "source_timestamp": { "type": ["string", "null"] },
      "evidence_type": { "enum": ["research", "instrumented_measurement", "coaching_experience", "video_observation", "expert_opinion", "analogy", "unknown"] },
      "numeric_normative": { "type": "boolean" },
      "numeric_evidence_ref": { "type": ["string", "null"] }
    }
  }
}
