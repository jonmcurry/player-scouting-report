{
  "name": "player-scouting-report",
  "version": "0.1.0",
  "private": true,
  "description": "Node/TypeScript CLI layer for the softball scouting-report pipeline: Supabase-backed coach editing, GCS media, Gemini-assisted drafts, and static HTML generation for GitHub Pages. Separate from and does not replace the existing Python pose3d pipeline (scripts/pose3d/).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "extract": "tsx src/cli/extract.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "ingest-phases": "tsx src/cli/ingestPhases.ts",
    "ingest-pose3d-frames": "tsx src/cli/ingestPose3dFrames.ts",
    "process-upload-queue": "tsx src/cli/processUploadQueue.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "analyze": "tsx src/cli/analyze.ts",
    "provision-coach": "tsx src/cli/provisionCoach.ts",
    "build:reports": "tsx src/cli/generate.ts",
    "db:migrate": "npx supabase db push",
    "db:reset": "npx supabase db reset"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^2.13.0",
    "@supabase/supabase-js": "^2.110.9",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
